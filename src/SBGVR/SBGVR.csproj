<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SBGVR</AssemblyName>
    <RootNamespace>SBGVR</RootNamespace>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(StageDir)plugins\</OutputPath>

    <Version>$(SBGVRVersion)</Version>
    <Product>SBGVR</Product>
    <AssemblyTitle>SBGVR</AssemblyTitle>
    <Description>Super Battle Golf fixes for the UUVR VR mod.</Description>
    <Authors>lmkHenlo</Authors>
    <Company>lmkHenlo</Company>
    <Copyright>Copyright (c) 2026 lmkHenlo</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built first by SBGVR.proj; shipped by the package, so not copied here. -->
    <Reference Include="Uuvr">
      <HintPath>$(StageDir)plugins\Uuvr.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Uuvr.XR.OpenXR">
      <HintPath>$(StageDir)plugins\Uuvr.XR.OpenXR.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
