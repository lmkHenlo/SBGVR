<Project>
  <!--
    Shared build settings for SBGVR and the vendored UUVR projects.

    Every path can be overridden on the command line, for example:
      dotnet build SBGVR.proj -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\Super Battle Golf"
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

    <!-- SBGVR's version. Also update Plugin.Version and thunderstore/manifest.json; the build checks they match. -->
    <SBGVRVersion>1.3.0</SBGVRVersion>

    <!-- The game install. The *_Data folder is named after the game's .exe. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Super Battle Golf</GameDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(GameDir)\Super Battle Golf_Data</GameDataDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDataDir)\Managed</ManagedDir>

    <!-- A BepInEx 5 folder that contains core\BepInEx.dll. Defaults to r2modman's Default profile. -->
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(APPDATA)\r2modmanPlus-local\SuperBattleGolf\profiles\Default\BepInEx</BepInExDir>

    <!--
      Compile against the game's own Mono class library (mscorlib, System, ...) instead of
      .NET Framework reference assemblies, so the build needs nothing from NuGet.
    -->
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>

    <!-- Everything the Thunderstore package contains is staged here before zipping. -->
    <ArtifactsDir>$(RepoRoot)artifacts\</ArtifactsDir>
    <StageDir>$(ArtifactsDir)stage\</StageDir>

    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!--
    References shared by every project: the game's assemblies (minus the class library, which
    FrameworkPathOverride already supplies) and BepInEx 5 with Harmony.
  -->
  <ItemGroup>
    <Reference Include="$(ManagedDir)\*.dll"
               Exclude="$(ManagedDir)\mscorlib.dll;$(ManagedDir)\System.dll;$(ManagedDir)\System.*.dll;$(ManagedDir)\Mono.*.dll;$(ManagedDir)\Microsoft.*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="SBGVRCheckPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\GameAssembly.dll')"
           Text="GameAssembly.dll not found in '$(ManagedDir)'. Pass -p:GameDir=... (the Super Battle Golf install folder)." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')"
           Text="BepInEx.dll not found in '$(BepInExDir)\core'. Pass -p:BepInExDir=... (a BepInEx 5 folder, such as an r2modman profile's BepInEx folder)." />
  </Target>
</Project>
